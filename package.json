{
  "name": "gen-architects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:css\" \"pnpm dev:server\"",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css --watch",
    "dev:server": "tsx watch src/server.tsx",
    "build": "pnpm typecheck && pnpm build:css",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css --minify",
    "start": "tsx src/server.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
