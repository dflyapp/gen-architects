{
  "name": "gen-architects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently \"pnpm dev:css\" \"pnpm dev:worker\"",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --watch",
    "dev:worker": "wrangler dev",
    "build": "pnpm typecheck && pnpm build:css && pnpm build:assets",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css --minify",
    "build:assets": "rm -rf dist && mkdir -p dist && cp -r public/. dist/ && cp -r src/assets dist/assets",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gen-architects-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gen-architects-db --remote",
    "preview": "pnpm build && wrangler dev",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^20.17.24",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "wrangler": "^4.0.0"
  }
}
